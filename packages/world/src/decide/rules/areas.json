{
  "version": 3,
  "domain": "areas",
  "note": "OSM tag rules for areas: surface = palette colour name; layer = drawing order where areas overlap (higher is drawn on top: 1 land use, 2 green, 3 hard or sandy surfaces, 4 water); scatter = seeded asset requests per square metre.",
  "rules": [
    {
      "id": "area.parking",
      "when": {
        "amenity": "parking"
      },
      "then": {
        "surface": "asphalt",
        "markings": "stalls",
        "curbs": true,
        "layer": 3
      }
    },
    {
      "id": "area.park",
      "when": {
        "leisure": ["park", "garden"]
      },
      "then": {
        "surface": "grass",
        "scatter": [
          {
            "asset": {
              "category": "tree"
            },
            "perM2": 0.004
          },
          {
            "asset": {
              "category": "prop.bench"
            },
            "perM2": 0.0001
          }
        ],
        "layer": 2
      }
    },
    {
      "id": "area.grass",
      "when": {
        "landuse": ["grass", "meadow", "village_green"]
      },
      "then": {
        "surface": "grass",
        "layer": 2
      }
    },
    {
      "id": "area.residential",
      "when": {
        "landuse": "residential"
      },
      "then": {
        "surface": "grass",
        "scatter": [
          {
            "asset": {
              "category": "tree"
            },
            "perM2": 0.0015
          },
          {
            "asset": {
              "category": "bush"
            },
            "perM2": 0.0015
          }
        ],
        "layer": 1
      }
    },
    {
      "id": "area.wood",
      "when": {
        "natural": "wood"
      },
      "then": {
        "surface": "grass.shade",
        "scatter": [
          {
            "asset": {
              "category": "tree",
              "want": {
                "leafType": "@leaf_type"
              }
            },
            "perM2": 0.012
          }
        ],
        "layer": 2
      }
    },
    {
      "id": "area.forest",
      "when": {
        "landuse": "forest"
      },
      "then": {
        "surface": "grass.shade",
        "scatter": [
          {
            "asset": {
              "category": "tree",
              "want": {
                "leafType": "@leaf_type"
              }
            },
            "perM2": 0.012
          }
        ],
        "layer": 2
      }
    },
    {
      "id": "area.water",
      "when": {
        "natural": "water"
      },
      "then": {
        "surface": "water",
        "layer": 4
      }
    },
    {
      "id": "area.sand",
      "when": {
        "natural": ["sand", "beach"]
      },
      "then": {
        "surface": "sand",
        "layer": 3
      }
    },
    {
      "id": "area.retail",
      "when": {
        "landuse": ["retail", "commercial"]
      },
      "then": {
        "surface": "paving",
        "layer": 1.5
      },
      "note": "Layer 1.5: above the residential land use it often overlaps, below parks and car parks. Two areas on the same layer would flicker where they overlap."
    },
    {
      "id": "area.bare",
      "when": {
        "landuse": ["construction", "brownfield"]
      },
      "then": {
        "surface": "sand",
        "layer": 1.5
      },
      "note": "Layer 1.5: above the residential land use it often overlaps, below parks and car parks. Two areas on the same layer would flicker where they overlap."
    }
  ]
}
