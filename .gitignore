# Dependencies
node_modules/
.pnpm-store/

# Never commit other package managers' lockfiles (pnpm only)
package-lock.json
yarn.lock

# Build output and caches
dist/
build/
.vite/
*.tsbuildinfo
coverage/
.cache/

# Secrets and local settings (keep a committed .env.example if needed)
.env
.env.*
!.env.example
*.local

# Generated world data / local tile cache
tile-cache/
.tiles/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editors and OS
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp

# Blender backups and autosaves
*.blend1
*.blend2
*.blend@
